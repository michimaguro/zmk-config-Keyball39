#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&nice_view_spi { cs-gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>; };

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        // シート「レイヤー0」
        default_layer {
            label = "QWRT";
            bindings = <
&kp Q            &kp W            &kp E     &kp R          &kp T                                        &kp Y     &kp U          &kp I      &kp O    &lt 5 P
&mt LGUI A       &kp S            &kp D     &kp F          &kp G                                        &kp H     &kp J          &kp K      &kp L    &mt RGUI ENTER
&mt LSHFT Z      &kp X            &kp C     &kp V          &kp B                                        &kp N     &kp M          &kp COMMA  &kp DOT  &mt RSHFT SLASH
&lt 3 LG(C)      &mt LCTRL LG(V)  &kp LALT  &lt 1 LANG2    &lt 2 SPACE    &lt 5 TAB       &kp BSPC      &lt 1 LANG1                                  &lt 2 ESC
            >;
        };

        // シート「レイヤー1」（記号・矢印）
        number_layer {
            label = "NUM";
            bindings = <
&kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT                            &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR
&kp MINUS  &kp TILDE  &kp UNDER  &kp LA(Y)  &trans                               &kp COLON  &kp SQT    &kp UP     &kp LBKT   &kp RBKT
&kp EQUAL  &trans     &trans     &trans     &trans                               &kp SEMI   &kp LEFT   &kp DOWN   &kp RIGHT  &kp BSLH
&trans     &trans     &trans     &trans     &trans     &trans     &trans         &trans                                      &trans
            >;
        };

        // シート「レイヤー2」（テンキー・矢印）
        symbol_layer {
            label = "SYM";
            bindings = <
&kp LPAR   &kp N1     &kp N2     &kp N3     &kp RPAR                             &trans     &trans     &trans     &trans     &trans
&kp PLUS   &kp N4     &kp N5     &kp N6     &kp ASTRK                            &trans     &trans     &kp UP     &trans     &trans
&kp MINUS  &kp N7     &kp N8     &kp N9     &kp SLASH                            &trans     &kp LEFT   &kp DOWN   &kp RIGHT  &trans
&kp COMMA  &kp DOT    &kp N0     &kp EQUAL  &trans     &trans     &trans         &trans                                      &trans
            >;
        };

        // シート「レイヤー4」（Fキー・画面/音量・Bluetooth）
        function_layer {
            label = "FUN";
            bindings = <
&kp F1     &kp F2     &kp F3     &kp F4     &kp F5                               &kp C_BRI_DN  &kp C_BRI_UP  &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP
&kp F6     &kp F7     &kp F8     &kp F9     &kp F10                              &trans        &trans        &trans        &trans        &bootloader
&kp F11    &kp F12    &kp F13    &kp F14    &kp F15                              &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans     &trans     &trans     &trans     &trans     &trans     &trans         &trans                                                  &bootloader
            >;
        };

        // トラックボールを動かしたときに自動で出るマウス用レイヤー（左右クリックのみ）
        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans     &trans     &trans     &trans     &trans                               &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans                               &trans     &mkp LCLK  &mkp RCLK  &trans     &trans
&trans     &trans     &trans     &trans     &trans                               &trans     &trans     &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans     &trans         &trans                                      &trans
            >;
        };

        // シート「レイヤー3」（押している間はトラックボールでスクロール）
        scroll_layer {
            label = "SCROLL";
            bindings = <
&kp LC(LG(Q))  &trans           &mwh SCROLL_UP    &trans             &trans                               &trans         &kp LC(LEFT)  &kp LC(UP)  &kp LC(RIGHT)  &trans
&trans         &mwh SCROLL_LEFT  &mwh SCROLL_DOWN  &mwh SCROLL_RIGHT  &kp LC(LEFT)                         &kp LC(RIGHT)  &mkp LCLK     &mkp RCLK   &trans         &trans
&trans         &trans           &trans            &kp LC(LS(N4))     &kp LC(LS(N5))                       &trans         &kp LG(LBKT)  &kp LG(R)   &kp LG(RBKT)   &trans
&bootloader    &trans           &trans            &trans             &trans     &trans     &trans         &trans                                                  &bootloader
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &bootloader                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans                          &trans
            >;
        };
    };
};
